# =============================================================
# ProofPay Environment Variables — copy to .env and fill in
# =============================================================

# ---- App ----
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
RUN_ROLE=web

# ---- Database ----
DATABASE_URL=postgresql://proofpay:proofpay@localhost:5432/proofpay

# ---- PayPal Sandbox ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_CLIENT_SECRET
# Register this webhook URL in PayPal dashboard → Webhooks
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_WEBHOOK_ID

# ---- Anthropic ----
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# Hard cap on daily LLM spend (USD)
LLM_DAILY_BUDGET_USD=5

# ---- Auth ----
# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_CHAR_HEX_STRING_MINIMUM_32_CHARS_REQUIRED_HERE

# ---- Demo / Judge Mode ----
DEMO_MODE=true
# Scale factor for timeouts in demo (1 = real time, 60 = 60x faster)
DEMO_TIME_SCALE=60
CHAOS_MODE=false
MAX_CONTRACT_DAYS=28
PURGE_ENABLED=false

# ---- Sandbox buyer (for Judge Mode auto-approval) ----
SANDBOX_BUYER_EMAIL=buyer@example.com
SANDBOX_BUYER_PASSWORD=your_sandbox_buyer_password

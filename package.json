{
  "name": "proofpay",
  "version": "0.1.0",
  "private": true,
  "description": "ProofPay — Pay when it's proven. AI-verified milestone payments with PayPal authorization holds.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx watch src/worker/index.ts",
    "worker:start": "tsx src/worker/index.ts",
    "mcp": "tsx watch src/mcp/server.ts",
    "mcp:start": "tsx src/mcp/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d && npm run db:migrate && npm run seed",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/run-eval.ts",
    "chaos": "tsx scripts/run-chaos.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "spike:paypal": "tsx scripts/paypal-spike.ts"
  },
  "dependencies": {
    "next": "15.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "drizzle-orm": "^0.41.0",
    "postgres": "^3.4.5",
    "zod": "^3.25.23",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@anthropic-ai/sdk": "^0.52.0",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "fast-json-patch": "^3.1.1",
    "zod-to-json-schema": "^3.24.5",
    "pdfkit": "^0.16.0",
    "ag-grid-react": "^33.0.4",
    "ag-grid-community": "^33.0.4",
    "lucide-react": "^0.468.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5",
    "class-variance-authority": "^0.7.1",
    "@tanstack/react-query": "^5.62.3",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/pdfkit": "^0.13.6",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8",
    "msw": "^2.7.0",
    "prettier": "^3.4.2",
    "@playwright/test": "^1.49.1",
    "@axe-core/playwright": "^4.10.1",
    "fast-check": "^3.23.1",
    "pino-pretty": "^13.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.3.3",
    "tailwindcss": "^3.4.17",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49"
  }
}

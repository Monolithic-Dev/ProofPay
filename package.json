{
  "name": "proofpay",
  "version": "0.1.0",
  "private": true,
  "description": "ProofPay — Pay when it's proven. AI-verified milestone payments with PayPal authorization holds.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx watch src/worker/index.ts",
    "worker:start": "tsx src/worker/index.ts",
    "mcp": "tsx watch src/mcp/server.ts",
    "mcp:start": "tsx src/mcp/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d && npm run db:migrate && npm run seed",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/run-eval.ts",
    "chaos": "tsx scripts/run-chaos.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "spike:paypal": "tsx scripts/paypal-spike.ts",
    "test:load": "tsx scripts/smoke-load.ts",
    "check:copy": "node scripts/check-copy.mjs",
    "canary": "tsx scripts/run-canary.ts",
    "bench": "tsx scripts/score-bench.ts --score",
    "attacks": "tsx scripts/run-external-attacks.ts --run"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.0",
    "zod": "^4.6.7",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@anthropic-ai/sdk": "^1.7.0",
    "jose": "^6.2.17",
    "pino": "^10.4.0",
    "fast-json-patch": "^3.1.1",
    "zod-to-json-schema": "^3.24.5",
    "pdfkit": "^0.20.2",
    "ag-grid-react": "^36.3.0",
    "ag-grid-community": "^36.3.0",
    "lucide-react": "^1.71.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "class-variance-authority": "^0.7.1",
    "@tanstack/react-query": "^5.107.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "nanoid": "^6.0.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/pdfkit": "^0.17.7",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "msw": "^3.0.4",
    "prettier": "^3.4.2",
    "@playwright/test": "^1.65.0",
    "@axe-core/playwright": "^4.10.1",
    "fast-check": "^4.10.2",
    "pino-pretty": "^13.0.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49"
  },
  "license": "MIT"
}
